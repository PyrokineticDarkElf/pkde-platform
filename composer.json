{
  "name": "pkde/platform",
  "description": "PKDE platform: the shared must-use plugins of every PKDE WordPress site (Bedrock), installed by Composer.",
  "type": "wordpress-muplugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "enshrined/svg-sanitize": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0"
  },
  "extra": {
    "installer-name": "pkde-platform"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest"
  }
}
